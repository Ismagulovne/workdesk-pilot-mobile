<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WorkDesk" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/wd_brand</item>
        <item name="android:colorPrimaryDark">@color/wd_brand</item>
        <item name="android:colorAccent">@color/wd_brand</item>
        <item name="android:colorControlActivated">@color/wd_brand</item>
        <item name="android:windowBackground">@color/wd_bg</item>
        <item name="android:statusBarColor">@color/wd_brand</item>
        <item name="android:navigationBarColor">@color/wd_bg</item>
        <item name="android:textColorPrimary">@color/wd_text</item>
        <item name="android:textColorSecondary">@color/wd_muted</item>
        <item name="android:textColorLink">@color/wd_link</item>
    </style>
    <style name="Theme.WorkDesk.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/wd_brand</item>
        <item name="android:colorBackground">@color/wd_surface</item>
        <item name="android:textColorPrimary">@color/wd_text</item>
        <item name="android:textColorSecondary">@color/wd_muted</item>
    </style>
</resources>
